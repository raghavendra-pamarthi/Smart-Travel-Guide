# Smart Travel Guide Admin configuration
ADMIN_ID=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional: SMTP is required if Admin Forgot Password email recovery is enabled.
ADMIN_RESET_EMAIL=admin@example.com
# Google Identity Services (Traveller "Continue with Google" only).
# Create a Web application OAuth client in Google Cloud and add your site's
# origins (for example http://localhost:5173) to Authorized JavaScript origins.
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
